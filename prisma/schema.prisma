// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Wajib KOSONG (tanpa url) karena koneksi udah di-handle sama prisma.config.ts dan db.ts lo
}

model User {
  id      String  @id @default(uuid())
  initial String  @unique
  name    String
  phone   String?
  email   String?
  role    String  @default("PIC_LOGISTIK")
password  String   @default("password123")
  // --- TAMBAHIN BARIS INI BRO ---
  team String @default("Lainnya")

  // Waktu terakhir password berubah (login upgrade plaintext->hash, ganti password sendiri,
  // atau reset oleh user:manage). Token session dengan iat lebih lama dari ini ditolak.
  sessionsValidFrom DateTime @default(now())

  createdAt DateTime @default(now())
updatedAt DateTime @default(now()) @updatedAt

  // FIX 2: Tambahin nama relasi biar nyambung sama tabel Ticket
  tasks Ticket[] @relation("PICTasks")

  // FIX 3: Tambahin balikan relasi dari tabel ActivityLog
  logs ActivityLog[]
}

model Ticket {
  id             String    @id @default(uuid())
  ticketNumber   String    @unique
  title          String
  description    String
  category       String    @default("Umum")
  status         Status    @default(OPEN)
  issueImgUrl    String?
  proofImgUrl    String?
  branchName     String
  requesterName  String?
  requesterEmail String?
  mediaRequest   String?
  requestDate    DateTime?
  slaDeadline    DateTime?

  picId String?
  // Relasi ini nyambung ke "tasks" di tabel User
  pic   User?   @relation("PICTasks", fields: [picId], references: [id])

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  priority   String    @default("MEDIUM") // Tambahin ini bro

  logs ActivityLog[]
}

model ActivityLog {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String

  // Relasi ini nyambung ke "logs" di tabel User
  user User @relation(fields: [userId], references: [id])

  action    String // Contoh: "COMMENT", "SYSTEM"
  message   String
  createdAt DateTime @default(now())
}

// Fase 3 Blueprint v3: counter nomor tiket per tahun (LOG-<year>-<lastNumber+1>), di-upsert
// dalam transaksi saat pembuatan tiket supaya tidak ada dua tiket yang membaca angka yang
// sama (race condition nomor tiket). `year` dalam WIB (src/lib/time.ts: wibYear), bukan
// tahun kalender server. Nilai awal diisi lewat scripts/seed-ticket-counter.ts (dry-run
// default) dari nomor tertinggi yang sudah ada -- WAJIB dijalankan setelah migration ini
// diterapkan dan SEBELUM kode baru (yang memakai tabel ini) di-deploy, lihat RELEASE-NOTES.md.
model TicketCounter {
  year       Int @id
  lastNumber Int @default(0)
}

enum Role {
  OPERATOR
  PIC_LOGISTIK
}

enum Status {
  OPEN
  IN_PROGRESS
  DONE
}
